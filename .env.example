# ---- Branding ----
NEXT_PUBLIC_COMPANY_NAME=LVL7
NEXT_PUBLIC_CALENDAR_LINK=https://calendly.com/lvl7hub/strategy-call
NEXT_PUBLIC_LOGO_URL=https://lvl7hub.com/lvl7logoflat.svg

# ---- Retargeting ----
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ---- Analysis (all free-tier / no-signup-required by default) ----
# Microlink.io free tier is used for OG/metadata + palette extraction across
# website, Facebook, and Instagram. No key required for low volume; add a key
# below if you upgrade for higher rate limits.
MICROLINK_API_KEY=

# Optional: swap DuckDuckGo scraping for Google Custom Search JSON API in
# production for more reliable profile discovery. Leave blank to use the
# free DuckDuckGo fallback baked into lib/search.ts.
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=
